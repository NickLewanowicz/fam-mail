# =============================================================================
# Fam Mail Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Development Mode — bypasses OIDC and creates a dev user automatically
# Set to true for local development without an OIDC provider
DEV_MODE=false

# PostGrid API Configuration
POSTGRID_MODE=test
POSTGRID_TEST_API_KEY=test_sk_...
POSTGRID_LIVE_API_KEY=live_sk_...
POSTGRID_FORCE_TEST_MODE=false
# Set to true for local development without PostGrid API keys
POSTGRID_MOCK=false
POSTGRID_WEBHOOK_SECRET=
POSTCARD_SIZE=6x4
POSTCARD_SENDER_ID=

# OIDC Configuration - NEW FOR BETA 1.0.0
OIDC_ISSUER_URL=https://accounts.google.com/.well-known/openid-configuration
OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:8484/api/auth/callback
OIDC_SCOPES=openid profile email

# JWT Configuration - NEW FOR BETA 1.0.0
JWT_SECRET=your-random-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Agent API (/api/v1) - machine keys for integrations (Hermes, OpenClaw, scripts)
# Comma-separated "key:label:email" entries; each key acts as its mapped user.
# The email must belong to a user who has logged in at least once.
# Example: API_KEYS=fam_9f2c1ab8:hermes:me@example.com,fam_77d0e3:openclaw:me@example.com
API_KEYS=

# IMAP Configuration - PAUSED FOR BETA 1.0.0
# Will be reintroduced in Beta 2.0.0
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=your@email.com
# IMAP_PASSWORD=app-specific-password
# IMAP_TLS=true
# IMAP_INBOX=INBOX
# SUBJECT_FILTER=Fammail Postcard
# POLL_INTERVAL_SECONDS=30
# INITIAL_SYNC_DAYS=0
# CATCH_UP_MODE=none
# REQUIRE_IMAGE_ATTACHMENT=true

# LLM Configuration - PAUSED FOR BETA 1.0.0
# Will be reintroduced in Beta 2.0.0
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-...
# LLM_MODEL=openai/gpt-4o
# LLM_ENDPOINT=https://openrouter.ai/api/v1
# LLM_MAX_TOKENS=1000

# Database
DATABASE_PATH=/data/fammail.db

# Server
PORT=8484
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173

# (SMTP notification settings were removed in 1.2.0 — the notification
# service was never wired up. Re-add when email confirmations ship.)
